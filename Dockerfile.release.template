FROM alpine:3.21

ARG TARGETARCH

RUN apk add --no-cache sqlite-libs

# Binary is placed as sanshain-${TARGETARCH} in the build context
# (mapped from x86_64/aarch64 naming to Docker's amd64/arm64 convention)
COPY sanshain-${TARGETARCH} /usr/local/bin/sanshain
RUN chmod +x /usr/local/bin/sanshain
COPY static/ /app/static/

WORKDIR /app

ENV DATABASE_URL="sqlite:/data/sanshain.db?mode=rwc"

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["sanshain"]

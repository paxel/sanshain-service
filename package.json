{
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "lint": "cargo clippy -- -D warnings",
    "test:unit": "cargo test",
    "test:itest": "./scripts/itest.sh",
    "test:ui": "npx playwright test tests/ui/smoke.test.js tests/ui/no_console_errors.test.js tests/ui/de_inlined.test.js tests/ui/link_crawl.test.js tests/ui/site_stepper.test.js tests/ui/permissions.test.js tests/ui/structure.test.js tests/ui/endpoint_filter.test.js",
    "screenshots": "./scripts/update_screenshots.sh",
    "record-walkthroughs": "./scripts/record-walkthroughs.sh",
    "test": "cargo test",
    "check": "npm run fmt:check && npm run lint && npm run test && npm run site:test",
    "build:css": "tailwindcss -i static/css/app.input.css -o static/css/app.css --minify",
    "site": "node scripts/build-site.js",
    "site:all": "node scripts/build-site-all.js",
    "site:test": "node --test tests/site/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "^2.5.6"
  }
}

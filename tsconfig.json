{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": [
    "static/js/graph.js",
    "static/js/graph-domains.js",
    "static/js/structure.js",
    "static/js/endpoint-filter.js",
    "static/js/pages/graph-0.js",
    "static/js/pages/graph-1.js",
    "static/js/pages/producers.js",
    "static/js/pages/consumers.js",
    "static/js/pages/yaml.js",
    "static/js/pages/products.js",
    "static/js/pages/observability.js",
    "static/js/pages/reports.js",
    "static/js/pages/report-viewer.js",
    "static/js/pages/dashboard.js",
    "static/js/pages/landing.js",
    "static/js/pages/service.js",
    "tests/ui"
  ],
  "include": [
    "types",
    "static/js",
    "site/assets",
    "scripts",
    "tests/site",
    "tests/ui",
    "eslint.config.js",
    "playwright.config.js"
  ]
}
